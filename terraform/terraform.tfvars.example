# Terraform Variables Configuration Example
# Copy this file to terraform.tfvars and update with your values
# NEVER commit terraform.tfvars to version control!

# AWS Configuration
aws_region   = "us-east-1"
project_name = "np-code-review"
environment  = "dev"

# VPC Configuration
vpc_cidr                 = "10.0.0.0/16"
availability_zones_count = 2

# ECS Configuration
ecs_task_cpu      = "512"   # 0.5 vCPU
ecs_task_memory   = "1024"  # 1 GB
ecs_desired_count = 1
container_port    = 8000

# ECR Configuration
ecr_image_tag = "latest"

# Secrets Manager Configuration
# These secrets must be created before applying Terraform
github_app_secret_name                = "np-code-review/github-app"
github_webhook_secret_name            = "np-code-review/github-webhook-secret"
azure_openai_credentials_secret_name  = "np-code-review/azure-openai-credentials"

# Health Check Configuration
health_check_path                = "/health"
health_check_interval            = 30
health_check_timeout             = 5
health_check_healthy_threshold   = 2
health_check_unhealthy_threshold = 3
