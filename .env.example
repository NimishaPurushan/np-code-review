# GitHub Configuration
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Optional: For GitHub App authentication
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=

# Azure OpenAI (enterprise / Microsoft Entra — client credentials, no API key)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# Tenant: directory GUID or domain (e.g. contoso.onmicrosoft.com)
AZURE_OPENAI_TENANT_ID=your-tenant-id-or-domain
AZURE_OPENAI_CLIENT_ID=your-app-registration-client-id
AZURE_OPENAI_CLIENT_SECRET=your-app-registration-client-secret
AZURE_OPENAI_API_VERSION=2024-08-01-preview
AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
# Must match token request scope (default matches c.py / Cognitive Services)
AZURE_OPENAI_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default

AZURE_OPENAI_MAX_TOKENS=4096
AZURE_OPENAI_TEMPERATURE=0.7

# Bot Behavior Settings
AUTO_REVIEW_ENABLED=true
REVIEW_ON_READY_FOR_REVIEW=true
REVIEW_ON_NEW_COMMITS=true

# Database Configuration
# SQLite (development - zero configuration)
DATABASE_URL=sqlite+aiosqlite:///./code_review.db

# PostgreSQL (production - recommended)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/database

# PostgreSQL Docker Configuration (when using docker-compose)
POSTGRES_USER=code_review
POSTGRES_PASSWORD=secure_password_change_in_production
POSTGRES_DB=code_review_db
POSTGRES_PORT=5432

# Application Settings
APP_PORT=8000

# PgAdmin Configuration (optional - for database management UI)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050